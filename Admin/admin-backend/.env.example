# ACROVIX ADMIN BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Do NOT commit the actual .env file. Use this as a guide.

# --- Server ---
PORT=8081

# --- Database ---
# For development use Neon DEV branch. For production use Neon PROD branch.
DATABASE_URL=jdbc:postgresql://ep-example-host.neon.tech/acrovix_db
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# --- JWT Authentication ---
# MUST be a strong, random, long secret in production
JWT_SECRET=your_super_secret_jwt_key_here_must_be_very_long
JWT_EXPIRATION_MS=86400000

# --- Initial Super Admin ---
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@acrovix.com
INITIAL_ADMIN_PASSWORD=admin123

# --- CORS ---
# In production, this should be https://admin.acrovix.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Integrations ---
GEMINI_API_KEY=your_gemini_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM_EMAIL=sales@acrovix.com
MAIL_FROM_NAME=ACROVIX Sales
ENQUIRY_NOTIFICATION_EMAIL=admin@acrovix.com
