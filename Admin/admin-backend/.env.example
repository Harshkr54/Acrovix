# ACROVIX ADMIN BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Do NOT commit the actual .env file. Use this as a guide.

# --- Server ---
PORT=8081

# --- Environment and Server Configuration ---
# Set to 'prod' for production (enforces ddl-auto=validate, requires all secrets)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL Database ---
DB_URL=jdbc:postgresql://localhost:5432/acrovix_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# --- Authentication & Bootstrap ---
JWT_SECRET=must_be_at_least_32_characters_long_for_hs256_in_prod
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@acrovix.com
INITIAL_ADMIN_PASSWORD=your_initial_admin_password_here

# --- External APIs ---
RESEND_API_KEY=your_resend_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Mail Application Settings ---
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your_brevo_smtp_login
BREVO_SMTP_PASSWORD=your_brevo_smtp_key

MAIL_FROM_EMAIL=sales@acrovix.com
MAIL_FROM_NAME=ACROVIX INNOVATIONS PRIVATE LIMITED

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://admin.acrovix.com

# --- Integrations ---
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM_EMAIL=sales@acrovix.com
MAIL_FROM_NAME=ACROVIX Sales
ENQUIRY_NOTIFICATION_EMAIL=admin@acrovix.com
