# ACROVIX Backend Environment Variables Template (.env.example)

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/acrovix_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Server Configuration
SERVER_PORT=8080

# Resend Configuration
RESEND_API_KEY=your_resend_api_key_here

# Mail Application Settings
MAIL_FROM_EMAIL=sales@acrovix.com
MAIL_FROM_NAME=ACROVIX
ENQUIRY_NOTIFICATION_EMAIL=sales@acrovix.com

# Google Gemini AI (Free — get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

