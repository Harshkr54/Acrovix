# ACROVIX Backend Environment Variables Template (.env.example)

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/acrovix_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Server Configuration
SERVER_PORT=8080

# Brevo SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your_brevo_smtp_login
BREVO_SMTP_PASSWORD=your_brevo_smtp_key

# Mail Application Settings
MAIL_FROM_EMAIL=sweta@acrovix.com
MAIL_FROM_NAME=ACROVIX
ENQUIRY_NOTIFICATION_EMAIL=sweta@acrovix.com
